# Server Port
PORT=5000

# Local MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=student_db
DB_PORT=3306

# Cloud MySQL Option (Alternative to individual DB_* fields above)
# DATABASE_URL=mysql://user:password@host:port/database
# DB_SSL=true

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_replace_this_with_random_string

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
